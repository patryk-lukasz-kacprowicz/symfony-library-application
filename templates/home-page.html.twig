{% extends 'base.html.twig' %}

{% block title %}List on endpoints!{% endblock %}

{% block body %}
    <div class="row mb-3">
        <div class="col-sm-12">
            <h1>Hello!</h1>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-sm-12">
            This is list of our endpoints:
        </div>

        <div class="col-sm-12">
            <div class="row mt-5 mb-3 ep-element">
                <div class="position-number">1</div>
                <div class="col-sm-12">
                    <p class="pb-0 mb-0">Display all books from library</p>
                    <p class="pb-0 mb-0">Method: GET</p>
                    <code>/api/books</code>

                    <div class="row mb-3 mt-1">
                        <div class="col-sm-6">
                            <p class="pb-0 mb-0">If success you can see something like that:</p>
                            <pre>{
    "status": "success",
    "books": {
        {
            "id": 1,
            "name": "Harry Potter ...",
            "amount": 5,
            "price": "19.99",
            "currency": "PLN",
        },

        ...
    }
}</pre>
                        </div>
                        <div class="col-sm-6">
                            <p class="pb-0 mb-0">If error</p>
                            <pre>{
    "status": "error",
    "message": "Something went wrong, please try again!",
}
                            </pre>
                            <small>Message will contain the approximate reason for the error.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-3 ep-element">
                <div class="position-number">2</div>
                <div class="col-sm-12">
                    <p class="pb-0 mb-0">Display selected book</p>
                    <p class="pb-0 mb-0">Method: GET</p>
                    <code>/api/book/{id}</code>

                    <div class="row mb-3 mt-1">
                        <div class="col-sm-6">
                            <p class="pb-0 mb-0">If success you can see something like that:</p>
                            <pre>{
    "status": "success",
    "message": "Successful get list of books!",
    "data": {
        "id": 1,
        "author": "J.K. Rowling",
        "name": "Harry Potter ...",
        "amount": 5,
        "price": "19.99",
        "currency": "PLN",
    }
}</pre>
                        </div>
                        <div class="col-sm-6">
                            <p class="pb-0 mb-0">If error</p>
                            <pre>{
    "status": "error",
    "message": "Something went wrong, please try again!",
}
                            </pre>
                            <small>Message will contain the approximate reason for the error.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-3 ep-element">
                <div class="position-number">3</div>
                <div class="col-sm-12">
                    <p class="pb-0 mb-0">Store new book in virtual library</p>
                    <p class="pb-0 mb-0">Method: POST</p>
                    <code>/api/books</code>

                    <p class="pb-0 mt-3 mb-0">Fields:</p>
                    <div class="row mb-3">
                        <div class="col-sm-12">
                            <code>visible</code> nullable, default:false, boolean
                        </div>

                        <div class="col-sm-12">
                            <code>author</code> required, string, max:255
                        </div>

                        <div class="col-sm-12">
                            <code>name</code> required, string, max:255
                        </div>

                        <div class="col-sm-12">
                            <code>amount</code> required, integer
                        </div>

                        <div class="col-sm-12">
                            <code>price</code> required, float
                        </div>

                        <div class="col-sm-12">
                            <code>currency</code> required, string, max:255
                        </div>
                    </div>

                    <div class="row mb-3 mt-1">
                        <div class="col-sm-6">
                            <p class="pb-0 mb-0">If success you can see something like that:</p>
                            <pre>{
    "status": "success",
    "message": "Successful stored book!",
    "data": {
        "id": 999,
        "author": "Antoine de Saint-Exupéry",
        "name": "The Little Prince",
        "amount": 2,
        "price": "49.99",
        "currency": "PLN",
    }
}</pre>
                        </div>
                        <div class="col-sm-6">
                            <p class="pb-0 mb-0">If error</p>
                            <pre>{
    "status": "error",
    "message": "Something went wrong, please try again!",
}
                            </pre>
                            <small>Message will contain the approximate reason for the error.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-3 ep-element">
                <div class="position-number">4</div>
                <div class="col-sm-12">
                    <p class="pb-0 mb-0">Update selected book data</p>
                    <p class="pb-0 mb-0">Method: PUT</p>
                    <code>/api/book/{id}</code>

                    <p class="pb-0 mt-3 mb-0">Fields:</p>
                    <div class="row mb-3">
                        <div class="col-sm-12">
                            <code>visible</code> nullable, default:false, boolean
                        </div>

                        <div class="col-sm-12">
                            <code>author</code> required, string, max:255
                        </div>

                        <div class="col-sm-12">
                            <code>name</code> required, string, max:255
                        </div>

                        <div class="col-sm-12">
                            <code>amount</code> required, integer
                        </div>

                        <div class="col-sm-12">
                            <code>price</code> required, float
                        </div>

                        <div class="col-sm-12">
                            <code>currency</code> required, string, max:255
                        </div>
                    </div>

                    <div class="row mb-3 mt-1">
                        <div class="col-sm-6">
                            <p class="pb-0 mb-0">If success you can see something like that:</p>
                            <pre>{
    "status": "success",
    "message": "Successful updated book!",
    "data": {
        "id": 999,
        "author": "J.K. Rowling",
        "name": "The Little Prince",
        "amount": 2,
        "price": "29.99",
        "currency": "PLN",
    }
}</pre>
                        </div>
                        <div class="col-sm-6">
                            <p class="pb-0 mb-0">If error</p>
                            <pre>{
    "status": "error",
    "message": "Something went wrong, please try again!",
}
                            </pre>
                            <small>Message will contain the approximate reason for the error.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-3 ep-element">
                <div class="position-number">5</div>
                <div class="col-sm-12">
                    <p class="pb-0 mb-0">Delete selected book from virtual library</p>
                    <p class="pb-0 mb-0">Method: DELETE</p>
                    <code>/api/book/{id}</code>

                    <div class="row mb-3 mt-1">
                        <div class="col-sm-6">
                            <p class="pb-0 mb-0">If success you can see something like that:</p>
                            <pre>{
    "status": "success",
    "message": "Successful deleted book!",
}</pre>
                        </div>
                        <div class="col-sm-6">
                            <p class="pb-0 mb-0">If error</p>
                            <pre>{
    "status": "error",
    "message": "Something went wrong, please try again!",
}
                            </pre>
                            <small>Message will contain the approximate reason for the error.</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
